// ZenLink Next main window. Same idea as v2: header with the everyday actions,
// the picture, a shortcut bar under it, and Settings docked at the side.
// The window hugs the picture; opening Settings widens it, closing shrinks it.

import { ScrollView } from "std-widgets.slint";
import { Theme, I18n } from "theme.slint";
import { Glass, Icon, GlassButton, Seg, Toggle, GlassSlider, Row, Card, Chip, Tip } from "widgets.slint";

export { Theme, I18n }

export struct Prefs {
    theme: string,          // light | dark | system
    glass-on: bool,         // Liquid Glass on; off = solid window
    glass: float,           // thickness 0..100: 0 = fully clear, 100 = thick frosted
    lens: bool,             // refraction / lensing layer
    lang: string,           // id | en
    fit: string,            // contain | cover | fill
    fit-window: bool,
    rotation: string,       // auto | 0 | 90 | 180 | 270
    crop-l: float, crop-t: float, crop-r: float, crop-b: float,
    audio-out: string,      // pc | device
    volume: float,
    lip-sync: bool,
    audio-buffer: string,   // low | normal | high
    touch: bool,
    keyboard: bool,
    gestures: bool,
    auto-start: bool,
    close-to-tray: bool,
    on-top: bool,
    stats: bool,
    dots: bool,             // animated dot background
}

// Window controls, Windows order (min, max, close) on the right, drawn as
// coloured dots with the Windows glyph always visible inside.
component TrafficLights inherits HorizontalLayout {
    callback act(string);
    in property <bool> maximized;
    spacing: 8px;
    alignment: center;
    for b in [
        { id: "min", c: #febc2e, g: "\u{E921}" },
        { id: "max", c: #28c840, g: "\u{E922}" },
        { id: "close", c: #ff5f57, g: "\u{E8BB}" },
    ]: Rectangle {
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        background: ta.pressed ? b.c.darker(25%) : ta.has-hover ? b.c.brighter(10%) : b.c;
        border-width: 0.5px;
        border-color: #00000030;
        Text {
            text: b.id == "max" && root.maximized ? "\u{E923}" : b.g;
            font-family: Theme.icons;
            font-size: 8px;
            color: #000000a0;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Tip.shown = false; root.act(b.id); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = b.id == "min" ? I18n.t("Kecilkan", "Minimise") : b.id == "close" ? I18n.t("Tutup", "Close")
                        : root.maximized ? I18n.t("Pulihkan", "Restore") : I18n.t("Perbesar", "Maximise");
                    Tip.x = self.absolute-position.x + self.width / 2;
                    Tip.top = self.absolute-position.y;
                    Tip.bottom = self.absolute-position.y + self.height;
                    Tip.shown = true;
                } else {
                    Tip.shown = false;
                }
            }
        }
    }
}

// The window's own header: no card of its own, it is the top of the glass
// window (no header-inside-a-header).
component TopBar inherits Rectangle {
    in property <string> device;
    in property <string> phase;
    in property <string> link;
    in property <string> stats;
    in property <bool> settings-open;
    in property <bool> muted;
    callback start();
    callback stop();
    callback restart();
    callback settings();
    callback mute();
    callback rotate();
    callback fit-next();
    callback window-action(string);
    in property <string> fit;
    in property <bool> compact;
    in property <bool> maximized;
    in property <bool> fullscreen;
    property <bool> live: phase == "streaming";
    in property <string> need; // the device needs something before Start ("" = ready)
    property <bool> blocked: !live && phase != "connecting" && phase != "activating" && device != "" && need != "";
    property <bool> busy: phase == "connecting" || phase == "activating";
    height: 46px;
    // Empty header space moves the window; double-click maximises.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.window-action("drag");
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;
        alignment: stretch;
        // App identity: always visible, the wordmark only when there is room.
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../../ui/logo-256.png");
                width: 24px;
                height: 24px;
            }
        }
        Text {
            text: "ZenLink";
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        // Status: a dot when narrow (name in its tooltip), a pill otherwise.
        if compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: live ? Theme.accent : busy || blocked ? #f59e0b : #22c55e;
            border-width: 2px;
            border-color: Theme.dark ? #ffffff33 : #ffffffcc;
          }
        }
        if !compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: pillT.preferred-width + 16px;
            height: 24px;
            border-radius: 12px;
            background: live ? Theme.accent-soft : Theme.raise;
            border-width: 1px;
            border-color: Theme.line;
            pillT := Text {
                text: live ? I18n.t("Mirroring", "Mirroring") : busy ? I18n.t("Menyambung…", "Connecting…") : blocked ? I18n.t("Perlu tindakan", "Action needed") : I18n.t("Siap", "Ready");
                font-size: 11px;
                font-weight: 600;
                color: live ? Theme.accent : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
          }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            if !compact: Text {
                text: device == "" ? I18n.t("Belum ada perangkat", "No device") : device + (link == "" ? "" : "  ·  " + link);
                font-size: 11.5px;
                color: Theme.text-2;
                overflow: elide;
            }
            if stats != "": Text { text: stats; font-size: 10.5px; color: Theme.text-3; overflow: elide; font-family: "Cascadia Mono"; }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E72C}";
            label: compact ? "" : I18n.t("Mulai ulang", "Restart");
            tip: I18n.t("Mulai ulang koneksi", "Restart the connection");
            clicked => { root.restart(); }
        }
        if !live && !busy: GlassButton {
            y: (parent.height - self.height) / 2;
            primary: true;
            icon: "\u{E768}";
            label: compact ? "" : I18n.t("Mulai", "Start");
            tip: I18n.t("Mulai mirroring", "Start mirroring");
            clicked => { root.start(); }
        }
        if live || busy: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E71A}";
            label: compact ? "" : "Stop";
            tip: I18n.t("Hentikan mirroring", "Stop mirroring");
            clicked => { root.stop(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: muted ? "\u{E74F}" : "\u{E767}";
            tip: muted ? I18n.t("Suara mati — klik untuk nyalakan", "Sound off — click to turn on") : I18n.t("Suara di PC — klik untuk bisukan", "Sound on PC — click to mute");
            active: !muted;
            clicked => { root.mute(); }
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E7AD}";
            clicked => { root.rotate(); }
            tip: I18n.t("Putar tampilan", "Rotate view");
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            label: fit == "contain" ? "AUTO" : fit == "cover" ? "EDGE" : "FILL";
            tip: I18n.t("Mode tampilan: Auto-Fit / Tepi-ke-tepi / Regang", "View mode: Auto-fit / Edge to edge / Stretch");
            active: true;
            clicked => { root.fit-next(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: root.fullscreen ? "\u{E73F}" : "\u{E740}";
            active: root.fullscreen;
            tip: root.fullscreen ? I18n.t("Keluar layar penuh", "Exit full screen") : I18n.t("Layar penuh", "Full screen");
            clicked => { root.window-action("fullscreen"); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E713}";
            active: settings-open;
            tip: I18n.t("Pengaturan", "Settings");
            clicked => { root.settings(); }
        }
        Rectangle {
            width: 1px;
            background: Theme.dark ? #ffffff1f : #0000001a;
        }
        Rectangle { width: 2px; }
        TrafficLights {
            maximized: root.maximized;
            act(a) => { root.window-action(a); }
        }
    }
}

// ZenLink dock: a floating glass capsule centred under the picture,
// only as wide as its buttons (scrolls when the window is narrower).
component BottomBar inherits Rectangle {
    callback action(string);
    in property <bool> compact;
    height: 46px;
    dock := Glass {
        width: min(root.width, row.min-width);
        x: (root.width - self.width) / 2;
        height: root.height;
        border-radius: self.height / 2;
        fl := Flickable {
            content-width: max(self.width, row.min-width);
            interactive: row.min-width > self.width;
            row := HorizontalLayout {
                width: fl.content-width;
                height: dock.height;
                padding: 7px;
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                alignment: center;
                Chip { icon: "\u{E76B}"; tip: I18n.t("Geser ke kiri (kembali)", "Swipe left (back)"); label: compact ? "" : I18n.t("Geser kiri", "Swipe left"); clicked => { root.action("swipe-left"); } }
                Chip { icon: "\u{E80F}"; tip: I18n.t("Layar Utama", "Home screen"); label: compact ? "" : "Home"; clicked => { root.action("home"); } }
                Chip { icon: "\u{E8A9}"; tip: I18n.t("App terbaru", "Recent apps"); label: compact ? "" : I18n.t("Terbaru", "Recent"); clicked => { root.action("switcher"); } }
                Chip { icon: "\u{E76C}"; tip: I18n.t("Geser ke kanan", "Swipe right"); label: compact ? "" : I18n.t("Geser kanan", "Swipe right"); clicked => { root.action("swipe-right"); } }
                Rectangle { width: 1px; background: Theme.dark ? #ffffff1f : #0000001a; }
                Chip { icon: "\u{E9E9}"; tip: I18n.t("Pusat Kontrol", "Control Center"); label: compact ? "" : I18n.t("Kontrol", "Control"); clicked => { root.action("control-center"); } }
                Chip { icon: "\u{EA8F}"; tip: I18n.t("Notifikasi", "Notifications"); label: compact ? "" : I18n.t("Notifikasi", "Alerts"); clicked => { root.action("notifications"); } }
                Chip { icon: "\u{E72E}"; tip: I18n.t("Kunci layar", "Lock screen"); label: compact ? "" : I18n.t("Kunci", "Lock"); clicked => { root.action("lock"); } }
            }
        }
    }
}

// One step of the connect card (like v2: done / active / todo / failed).
component FlowStep inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> state; // "done" | "active" | "todo" | "failed"
    in property <bool> last;
    property <color> c: state == "done" ? Theme.ok : state == "active" ? #f0b43c : state == "failed" ? #ff6961 : Theme.text-3;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: state == "done" || state == "failed" ? c : transparent;
            border-width: state == "done" || state == "failed" ? 0px : 1.5px;
            border-color: state == "active" ? c.with-alpha(0.35) : c.with-alpha(0.5);
            if state == "done" || state == "failed": Text {
                text: state == "done" ? "\u{E73E}" : "\u{E711}";
                font-family: "Segoe Fluent Icons";
                font-size: 11px;
                color: #101010;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Spinning arc while this step runs.
            if state == "active": Path {
                width: 22px;
                height: 22px;
                viewbox-width: 22;
                viewbox-height: 22;
                stroke: c;
                stroke-width: 2px;
                commands: "M 11 1.5 A 9.5 9.5 0 0 1 20.5 11";
                transform-rotation: (animation-tick() / 900ms) * 360deg;
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: title; font-size: 13.5px; font-weight: 600; color: state == "todo" ? Theme.text-3 : state == "active" ? c : Theme.text; }
            Text { text: sub; font-size: 11.5px; color: state == "active" ? Theme.text : Theme.text-3; wrap: word-wrap; }
        }
    }
    if !last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// Shown in the stage while there is no picture: the device ready to start
// (phone, cable, name), then the 1-2-3-4 connect card like v2.
component Placeholder inherits Rectangle {
    in property <string> phase;
    in property <string> device;
    in property <string> message;
    // Connect card: step -1 = hidden, 0..4; kind "apple" | "usbdirect" | "airplay".
    in property <int> flow-step: -1;
    in property <bool> flow-failed;
    in property <string> flow-kind: "apple";
    in property <bool> wifi;
    // What stands between the device and Start ("" = ready): restore, bind,
    // package, removefilter, mode, wifi, trust.
    in property <string> need;
    callback start();
    callback dismiss();
    callback fix();
    property <bool> card: flow-step >= 0;
    property <color> tone: device == "" ? Theme.text-3 : need != "" ? Theme.warn : Theme.ok;
    property <string> need-label: need == "trust" ? I18n.t("Perlu Trust", "Needs Trust")
        : need == "wifi" ? I18n.t("Wi-Fi belum siap", "Wi-Fi not set up")
        : need == "mode" ? I18n.t("Pilih mode", "Choose a mode")
        : I18n.t("Perlu driver", "Needs a driver");
    property <string> need-title: need == "restore" ? I18n.t("Kembalikan driver Apple", "Restore the Apple driver")
        : need == "bind" ? I18n.t("Pasang driver ZenLink Studio", "Install the ZenLink Studio driver")
        : need == "package" ? I18n.t("libusb-win32 belum terpasang", "libusb-win32 is not installed")
        : need == "removefilter" ? I18n.t("Hapus filter libusb0 dulu", "Remove the libusb0 filter first")
        : need == "mode" ? I18n.t("Pilih mode koneksi", "Choose a connection mode")
        : need == "wifi" ? I18n.t("Wi-Fi belum diatur", "Wi-Fi is not set up yet")
        : I18n.t("Buka kunci dan tekan Percayai", "Unlock it and tap Trust");
    property <string> need-hint: need == "restore" ? I18n.t("Perangkat ini memakai driver ZenLink Studio, jadi mode Apple tidak bisa melihatnya. Kembalikan driver Apple, atau ganti ke mode ZenLink Studio.", "This device uses the ZenLink Studio driver, so Apple mode cannot see it. Restore the Apple driver, or switch to ZenLink Studio.")
        : need == "bind" ? I18n.t("ZenLink Studio memakai driver libusb0 di perangkat. Pasang drivernya, atau ganti ke mode Apple Driver.", "ZenLink Studio uses the libusb0 driver on the device. Install it, or switch to Apple Driver mode.")
        : need == "package" ? I18n.t("Pasang driver iOS TikTok LIVE Studio atau libusb-win32 sekali, lalu tekan Periksa driver. Atau pakai mode Apple Driver.", "Install the iOS driver of TikTok LIVE Studio or libusb-win32 once, then press Check drivers. Or use Apple Driver mode.")
        : need == "removefilter" ? I18n.t("Filter libusb0 menumpuk di driver Apple. Ini bisa membuat Windows crash.", "A libusb0 filter is stacked on the Apple driver. It can crash Windows.")
        : need == "mode" ? I18n.t("Pilih Apple Driver atau ZenLink Studio untuk lanjut.", "Pick Apple Driver or ZenLink Studio to continue.")
        : need == "wifi" ? I18n.t("Colokkan kabel sekali, lalu tekan Atur Wi-Fi di Pengaturan. Atau pilih Kabel.", "Plug in the cable once, then press Set up Wi-Fi in Settings. Or choose Cable.")
        : I18n.t("Buka kunci perangkat, tekan Percayai (Trust) kalau muncul, lalu coba lagi.", "Unlock the device, tap Trust if it asks, then try again.");
    property <[[string]]> texts: flow-kind == "usbdirect" ? [
            [I18n.t("Deteksi perangkat", "Detect device"), I18n.t("Ditemukan di USB lewat driver libusb0", "Found on USB through the libusb0 driver")],
            [I18n.t("Buka perangkat", "Open the device"), I18n.t("Mengalihkan ke mode tangkap layar", "Switching it to its screen-capture mode")],
            [I18n.t("Cek kepercayaan", "Check trust"), I18n.t("Biarkan tidak terkunci sementara ZenLink membuktikan PC ini dipercaya", "Keep it unlocked while ZenLink proves this PC is trusted")],
            [I18n.t("Mulai stream", "Start stream"), I18n.t("Menerima layar lewat ZenLink Studio", "Receiving the screen over ZenLink Studio")]]
        : flow-kind == "airplay" ? [
            [I18n.t("Perangkat tersambung", "Device connected"), I18n.t("iPhone/iPad memilih ZenLinkStudio di Pencerminan Layar", "Your iPhone/iPad chose ZenLinkStudio in Screen Mirroring")],
            [I18n.t("Koneksi aman", "Secure connection"), I18n.t("Pairing AirPlay dan pertukaran kunci FairPlay", "AirPlay pairing and FairPlay key exchange")],
            [I18n.t("Terima video", "Receive video"), I18n.t("Mendekripsi stream AirPlay", "Decrypting the AirPlay stream")],
            [I18n.t("Mulai stream", "Start stream"), I18n.t("Menerima layar lewat Wi-Fi", "Receiving the screen over Wi-Fi")]]
        : [
            [I18n.t("Deteksi perangkat", "Detect device"), I18n.t("Ditemukan lewat Apple Mobile Device Service", "Found through Apple Mobile Device Service")],
            [I18n.t("Koneksi aman", "Secure connection"), wifi ? I18n.t("Membuka tunnel Wi-Fi terenkripsi ke perangkat", "Opening an encrypted Wi-Fi tunnel to the device") : I18n.t("Membuka tunnel USB terenkripsi ke perangkat", "Opening an encrypted USB tunnel to the device")],
            [I18n.t("Siapkan perangkat", "Prepare the device"), I18n.t("Biarkan tidak terkunci. Pertama kali, image developer kecil dipasang.", "Keep it unlocked. The first time, a small developer image is installed.")],
            [I18n.t("Mulai stream", "Start stream"), I18n.t("Menerima layar dalam HEVC", "Receiving the screen in HEVC")]];
    property <float> pct: max(0, min(flow-step, 4)) / 4;
    animate pct { duration: 420ms; easing: ease-out; }
    function st(i: int) -> string {
        if flow-failed && i == max(flow-step, 0) { return "failed"; }
        if i < flow-step { return "done"; }
        if i == flow-step { return "active"; }
        return "todo";
    }

    // Ready / plug-in view.
    if !card: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 24px;
        padding-right: 24px;
        Rectangle {
            height: 196px;
            // Phone outline with its cable.
            Rectangle {
                x: (parent.width - 86px) / 2;
                y: 0px;
                width: 86px;
                height: 160px;
                border-radius: 18px;
                border-width: 2px;
                border-color: root.tone;
                background: Theme.dark ? #ffffff08 : #ffffff80;
                Rectangle { y: 8px; width: 26px; height: 6px; border-radius: 3px; background: root.tone; opacity: 0.6; }
            }
            if !wifi: Rectangle {
                x: (parent.width - 2px) / 2;
                y: 160px;
                width: 2px;
                height: 36px;
                background: device == "" ? Theme.text-3.with-alpha(0.5) : root.tone;
            }
        }
        if device != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: Theme.dark ? #ffffff0d : #ffffffa0;
                border-width: 1px;
                border-color: root.tone.with-alpha(0.45);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.tone; }
                    }
                    Text { text: device; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    Text { text: "·"; color: Theme.text-3; vertical-alignment: center; }
                    Text { text: need != "" ? root.need-label : wifi ? I18n.t("Siap · Wi-Fi", "Ready · Wi-Fi") : I18n.t("Siap", "Ready"); font-size: 12px; font-weight: 600; color: root.tone; vertical-alignment: center; }
                }
            }
        }
        Text {
            text: device == "" ? I18n.t("Colokkan iPhone atau iPad", "Plug in an iPhone or iPad") : need != "" ? root.need-title : I18n.t(device + " siap", device + " ready");
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: message != "" ? message
                : device != "" && need != "" ? root.need-hint
                : device == "" ? I18n.t("Pakai kabel USB, buka kunci, lalu tekan Percayai (Trust). Atau sambungkan lewat Wi-Fi.", "Use a USB cable, unlock it and tap Trust. Or connect over Wi-Fi.")
                : I18n.t("Buka kunci, lalu tekan Mulai mirroring.", "Unlock it, then press Start mirroring.");
            font-size: 12.5px;
            color: message != "" ? #ff8a80 : Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if device != "": HorizontalLayout {
            alignment: center;
            if need == "" || need == "trust": GlassButton { primary: true; icon: "\u{E768}"; label: need == "" ? I18n.t("Mulai mirroring", "Start mirroring") : I18n.t("Coba lagi", "Try again"); clicked => { root.start(); } }
            if need != "" && need != "trust": GlassButton {
                primary: true;
                icon: "\u{E90F}";
                label: need == "restore" ? I18n.t("Kembalikan driver Apple", "Restore Apple driver")
                    : need == "bind" ? I18n.t("Pasang driver", "Install driver")
                    : need == "removefilter" ? I18n.t("Hapus filter", "Remove filter")
                    : need == "mode" ? I18n.t("Pilih mode", "Choose mode")
                    : I18n.t("Buka pengaturan", "Open settings");
                clicked => { root.fix(); }
            }
        }
    }

    // Connect card (1-2-3-4) while connecting, with the error if it fails.
    if card: Rectangle {
        width: min(parent.width - 32px, 440px);
        height: cardL.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: Theme.dark ? #161618f2 : #fbfbfdf2;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        cardL := VerticalLayout {
            padding: 20px;
            spacing: 6px;
            HorizontalLayout {
                Text {
                    text: flow-failed ? I18n.t("Tidak bisa tersambung", "Couldn't connect")
                        : flow-step >= 4 ? I18n.t("Tersambung", "Connected")
                        : device != "" ? I18n.t("Menyambungkan ke " + device, "Connecting to " + device)
                        : I18n.t("Menyambungkan", "Connecting");
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: round(pct * 100) + "%"; font-size: 11.5px; color: Theme.text-3; vertical-alignment: center; font-family: "Cascadia Mono"; }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.dark ? #ffffff1a : #0000001a;
                Rectangle {
                    x: 0px;
                    width: parent.width * pct;
                    border-radius: 2px;
                    background: flow-failed ? #ff6961 : Theme.text;
                }
            }
            Rectangle { height: 6px; }
            for t[i] in texts: FlowStep {
                title: t[0];
                sub: t[1];
                state: root.st(i);
                last: i == 3;
            }
            if flow-failed: VerticalLayout {
                spacing: 12px;
                padding-top: 6px;
                Text { text: message; font-size: 12.5px; color: #ff8a80; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GlassButton { label: I18n.t("Tutup", "Close"); clicked => { root.dismiss(); } }
                    GlassButton { primary: true; icon: "\u{E72C}"; label: I18n.t("Coba lagi", "Try again"); clicked => { root.start(); } }
                }
            }
        }
    }
}

// One connection mode in the chooser: a selectable glass card.
component ModeCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> tag;
    in property <string> badge;
    in property <string> desc;
    in property <[{ ok: bool, text: string }]> points;
    in property <bool> selected;
    in property <color> tint;
    callback pick();
    border-radius: 16px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.14 : 0.10) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff73);
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? tint : Theme.line;
    animate background, border-color { duration: 220ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98.5% : 100%;
    transform-scale-y: ta.pressed ? 98.5% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 320ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
                Icon { text: root.icon; color: white; font-size: 15px; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; }
                Text { text: root.tag; font-size: 11px; color: Theme.text-2; }
            }
            if root.badge != "": VerticalLayout {
                alignment: start;
                Rectangle {
                    height: 20px;
                    width: badgeT.preferred-width + 14px;
                    border-radius: 10px;
                    background: root.tint.with-alpha(0.18);
                    badgeT := Text { text: root.badge; font-size: 10.5px; font-weight: 700; color: root.tint; }
                }
            }
            // Radio dot.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: root.selected ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    background: root.selected ? root.tint : transparent;
                    animate background { duration: 200ms; }
                    Rectangle {
                        width: root.selected ? 8px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                        animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
        }
        Text { text: root.desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        for p in root.points: HorizontalLayout {
            spacing: 7px;
            Icon {
                text: p.ok ? "\u{E73E}" : "\u{E711}";
                font-size: 10px;
                width: 14px;
                vertical-alignment: top;
                color: p.ok ? Theme.ok : Theme.text-3;
            }
            Text { text: p.text; font-size: 11.5px; color: p.ok ? Theme.text : Theme.text-2; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
}

// Small modal: driver confirmations, progress and results.
component NoticeSheet inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> ok;
    in property <string> cancel;
    callback answer(bool);
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    Glass {
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 20px;
        width: min(parent.width - 24px, 440px);
        height: min(parent.height - 24px, ncol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 20px * (1 - root.t);
        opacity: root.t;
        ncol := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
            Text { text: root.body; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
            if root.ok != "" || root.cancel != "": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.cancel != "": GlassButton { label: root.cancel; clicked => { root.answer(false); } }
                if root.ok != "": GlassButton { primary: true; label: root.ok; clicked => { root.answer(true); } }
            }
        }
    }
}

// First-run (or "change mode") sheet: nothing connects and no driver
// changes until a mode is chosen here.
component ModeChooser inherits Rectangle {
    in property <bool> cancelable;
    in property <string> active;     // mode in use now ("" = none yet)
    in property <string> link: "wired";
    in property <bool> remember: true;
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    callback choose(string, string, bool);
    callback cancel();
    property <string> pick: active;
    property <string> link-pick: link;
    property <bool> keep: remember;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 380ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    sheet := Glass {
        strong: true;
        // A modal sheet stays readable at any glass thickness.
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 22px;
        width: min(parent.width - 24px, 560px);
        height: min(parent.height - 24px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.t);
        opacity: root.t;
        transform-scale-x: 0.96 + 0.04 * root.t;
        transform-scale-y: 0.96 + 0.04 * root.t;
        ScrollView {
            col := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("../../../../ui/logo-256.png"); width: 40px; height: 40px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: I18n.t("ZenLink mau tersambung lewat apa?", "How should ZenLink connect?"); font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                        Text { text: I18n.t("Belum ada yang tersambung dan driver tidak diubah sampai kamu lanjut.", "Nothing connects and no driver changes until you continue."); font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                    if root.cancelable: VerticalLayout { alignment: start; GlassButton { icon: "\u{E711}"; tip: I18n.t("Batal", "Cancel"); clicked => { root.cancel(); } } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Bahasa / Language"; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; }
                    Seg {
                        width: 190px;
                        options: ["id", "en"];
                        labels: ["Indonesia", "English"];
                        value: root.prefs.lang;
                        changed(v) => { root.prefs.lang = v; root.prefs-changed(root.prefs); }
                    }
                }
                ModeCard {
                    icon: "\u{E83D}";
                    tint: #22c55e;
                    title: "Apple Driver";
                    tag: I18n.t("Standar · kontrol penuh", "Standard · full control");
                    badge: I18n.t("Disarankan", "Recommended");
                    desc: I18n.t("Pakai driver bawaan Apple. Paling kompatibel, stabil dan gampang.", "Uses Apple's own driver. Most compatible, stable and easy.");
                    points: [
                        { ok: true, text: I18n.t("Sampai 60 fps, HEVC (bitrate dibatasi perangkat, sekitar 4–6 Mbps)", "Up to 60 fps, HEVC (device-limited bitrate, about 4–6 Mbps)") },
                        { ok: true, text: I18n.t("Sentuh pakai mouse, keyboard, gestur dan tombol", "Mouse touch, keyboard, gestures and buttons") },
                        { ok: true, text: I18n.t("Driver Apple sendiri, tidak perlu pasang apa-apa", "Apple's own driver, nothing to install") },
                        { ok: true, text: I18n.t("Kabel atau Wi-Fi (setelah setup sekali pakai kabel)", "Cable or Wi-Fi (after a one-time setup with the cable)") },
                        { ok: true, text: I18n.t("iOS 17–26: Hybrid Control (eksperimental)", "iOS 17–26: Hybrid Control (experimental)") },
                        { ok: false, text: I18n.t("iOS 16 ke bawah: pakai ZenLink Studio", "iOS 16 or older: use ZenLink Studio") },
                    ];
                    selected: root.pick == "apple";
                    pick => { root.pick = "apple"; }
                }
                ModeCard {
                    icon: "\u{E945}";
                    tint: #ff5fa8;
                    title: "ZenLink Studio";
                    tag: I18n.t("Untuk live streaming", "For live streaming");
                    desc: I18n.t("Kualitas terbaik untuk streaming: bitrate tinggi (terukur 12–30 Mbps), sampai 60 fps, latensi sangat rendah. Butuh driver libusb0.", "Best quality for streaming: high bitrate (measured 12–30 Mbps), up to 60 fps, very low latency. Needs the libusb0 driver.");
                    points: [
                        { ok: true, text: I18n.t("Sampai 60 fps, resolusi native penuh lewat kabel, H.264 bitrate tinggi", "Up to 60 fps, full native resolution over the cable, high-bitrate H.264") },
                        { ok: true, text: I18n.t("Kabel (USB) atau Wi-Fi (AirPlay, tanpa driver)", "Cable (USB) or Wi-Fi (AirPlay, no driver)") },
                        { ok: false, text: I18n.t("Gambar dan suara saja: tanpa sentuh, keyboard, gestur", "Picture and sound only: no touch, keyboard or gestures") },
                        { ok: false, text: I18n.t("Aplikasi Apple tidak melihat perangkat sampai balik ke Apple Driver", "Apple apps can't see the device until you switch back") },
                    ];
                    selected: root.pick == "usbdirect";
                    pick => { root.pick = "usbdirect"; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("Sambungan", "Connection"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Seg {
                        width: 240px;
                        options: ["wired", "wireless"];
                        labels: [I18n.t("Kabel", "Cable"), "Wi-Fi"];
                        value: root.link-pick;
                        changed(v) => { root.link-pick = v; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("Ingat pilihan ini", "Remember my choice"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.keep; toggled(v) => { root.keep = v; } }
                }
                Text {
                    text: I18n.t("Bisa diganti kapan saja di Pengaturan › Koneksi & driver. Ganti mode bisa perlu restart app dan colok ulang kabel.",
                        "You can change it any time in Settings › Connection & driver. Changing it may need an app restart and reconnecting the cable.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    if root.cancelable: GlassButton { label: I18n.t("Batal", "Cancel"); clicked => { root.cancel(); } }
                    GlassButton {
                        primary: true;
                        enabled: root.pick != "";
                        icon: "\u{E72A}";
                        label: I18n.t("Lanjut", "Continue");
                        clicked => { root.choose(root.pick, root.link-pick, root.keep); }
                    }
                }
            }
        }
    }
}

component SettingsPanel inherits Glass {
    in-out property <Prefs> prefs;
    in property <string> driver-text;
    in property <string> connection;
    // Cable or Wi-Fi, for both Apple Driver and ZenLink Studio.
    in property <string> link: "wired";
    in property <string> mode;
    // Driver changes that fit the device (each asks for confirmation).
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    callback set-link(string);
    in property <string> stats-full;
    callback changed(Prefs);
    callback close();
    callback driver-action(string);
    border-radius: 20px;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-bottom: 4px;
            spacing: 10px;
            Image { source: @image-url("../../../../ui/logo-256.png"); width: 30px; height: 30px; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "ZenLink"; font-size: 15px; font-weight: 800; color: Theme.text; }
                Text { text: I18n.t("Pengaturan & kontrol", "Settings & controls"); font-size: 11px; color: Theme.accent; font-weight: 600; }
            }
            GlassButton { icon: "\u{E711}"; clicked => { root.close(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                padding-top: 6px;
                spacing: 10px;

                Card {
                    title: I18n.t("Tampilan", "Appearance");
                    icon: "\u{E790}";
                    tint-a: #f472b6;
                    tint-b: #db2777;
                    info: I18n.t("Liquid Glass memperlihatkan desktop di belakang jendela secara nyata. Ketebalan 0% = bening total tanpa blur, makin tinggi makin buram (blur asli Windows). Matikan untuk jendela solid tanpa kerja GPU tambahan.",
                        "Liquid Glass shows the real desktop behind the window. Thickness 0% = fully clear with no blur, higher = more frosted (Windows' own blur). Turn it off for a solid window with no extra GPU work.");
                    Seg {
                        options: ["light", "dark", "system"];
                        labels: [I18n.t("Terang", "Light"), I18n.t("Gelap", "Dark"), I18n.t("Sistem", "System")];
                        value: prefs.theme;
                        changed(v) => { root.prefs.theme = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: "Liquid Glass";
                        Toggle { checked: prefs.glass-on; toggled(v) => { root.prefs.glass-on = v; root.changed(root.prefs); } }
                    }
                    if prefs.glass-on: Row {
                        label: I18n.t("Ketebalan kaca", "Glass thickness");
                        Text { text: round(prefs.glass) + "%" + (prefs.glass < 1 ? I18n.t(" · bening", " · clear") : ""); font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    if prefs.glass-on: GlassSlider {
                        step: 5;
                        value: prefs.glass;
                        changed(v) => { root.prefs.glass = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Latar animasi", "Animated background");
                        Toggle { checked: prefs.dots; toggled(v) => { root.prefs.dots = v; root.changed(root.prefs); } }
                    }
                    Row {
                        label: I18n.t("Bahasa", "Language");
                        Seg {
                            width: 150px;
                            options: ["id", "en"];
                            labels: ["Indonesia", "English"];
                            value: prefs.lang;
                            changed(v) => { root.prefs.lang = v; root.changed(root.prefs); }
                        }
                    }
                }

                Card {
                    title: I18n.t("Layar & rasio", "Display & aspect");
                    icon: "\u{E7F4}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: I18n.t("Auto-Fit menampilkan seluruh layar perangkat. Tepi-ke-tepi mengisi area dan memotong pinggir. Jendela otomatis mengikuti ukuran dan orientasi (potret/lanskap) perangkat.",
                        "Auto-Fit shows the whole device screen. Edge-to-Edge fills the area and crops the sides. The window follows the device's size and orientation (portrait / landscape).");
                    Seg {
                        options: ["contain", "cover", "fill"];
                        labels: ["Auto-Fit", I18n.t("Tepi-ke-tepi", "Edge-to-Edge"), I18n.t("Regang", "Stretch")];
                        value: prefs.fit;
                        changed(v) => { root.prefs.fit = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Jendela ikut ukuran layar", "Window follows the screen");
                        hint: I18n.t("Potret / lanskap otomatis", "Portrait / landscape automatically");
                        Toggle { checked: prefs.fit-window; toggled(v) => { root.prefs.fit-window = v; root.changed(root.prefs); } }
                    }
                    Text { text: I18n.t("Rotasi", "Rotation"); font-size: 12.5px; color: Theme.text; }
                    Seg {
                        options: ["auto", "0", "90", "180", "270"];
                        labels: ["Auto", "0°", "90°", "180°", "270°"];
                        value: prefs.rotation;
                        changed(v) => { root.prefs.rotation = v; root.changed(root.prefs); }
                    }
                }


                Card {
                    title: I18n.t("Audio perangkat → PC", "Device audio → PC");
                    icon: "\u{E767}";
                    tint-a: #fb923c;
                    tint-b: #ea580c;
                    info: I18n.t("Suara diputar lewat WASAPI di PC ini. Lip sync menahan gambar sedikit supaya pas dengan suara. Buffer rendah = lebih rapat, tinggi = lebih tahan gangguan.",
                        "Sound plays through WASAPI on this PC. Lip sync holds the picture a little so it matches the sound. Low buffer is tighter, high rides out hiccups.");
                    Seg {
                        options: ["pc", "device"];
                        labels: [I18n.t("Di PC ini", "On this PC"), I18n.t("Hanya perangkat", "Device only")];
                        value: prefs.audio-out;
                        changed(v) => { root.prefs.audio-out = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Volume PC", "PC volume");
                        Text { text: round(prefs.volume) + "%"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    GlassSlider { value: prefs.volume; changed(v) => { root.prefs.volume = v; root.changed(root.prefs); } }
                    Row {
                        label: "Lip sync";
                        Toggle { checked: prefs.lip-sync; toggled(v) => { root.prefs.lip-sync = v; root.changed(root.prefs); } }
                    }
                    Seg {
                        options: ["low", "normal", "high"];
                        labels: [I18n.t("Rendah", "Low"), "Normal", I18n.t("Tinggi", "High")];
                        value: prefs.audio-buffer;
                        changed(v) => { root.prefs.audio-buffer = v; root.changed(root.prefs); }
                    }
                }

                Card {
                    title: I18n.t("Kontrol & pintasan", "Control & shortcuts");
                    icon: "\u{E765}";
                    tint-a: #38bdf8;
                    tint-b: #0284c7;
                    info: I18n.t("Klik dan seret = sentuh. Tombol Back mouse = kembali. Alt+U buka kunci, Alt+L kunci, Alt+V tempel, Alt+C salin teks layar, Alt+D redup, Alt+H putar.",
                        "Click and drag = touch. Mouse Back button = back. Alt+U unlock, Alt+L lock, Alt+V paste, Alt+C copy screen text, Alt+D dim, Alt+H rotate.");
                    Row { label: I18n.t("Sentuh dengan mouse", "Touch with the mouse"); Toggle { checked: prefs.touch; toggled(v) => { root.prefs.touch = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("Keyboard PC", "PC keyboard"); Toggle { checked: prefs.keyboard; toggled(v) => { root.prefs.keyboard = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("Gestur", "Gestures"); Toggle { checked: prefs.gestures; toggled(v) => { root.prefs.gestures = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: I18n.t("Koneksi & driver", "Connection & driver");
                    icon: "\u{E88E}";
                    tint-a: #34d399;
                    tint-b: #059669;
                    info: I18n.t("Apple Driver memakai driver bawaan Apple. ZenLink Studio memakai libusb0 untuk bitrate tinggi. Perubahan driver selalu minta konfirmasi dan izin administrator.",
                        "Apple Driver uses Apple's own driver. ZenLink Studio uses libusb0 for high bitrate. Driver changes always ask for confirmation and administrator approval.");
                    Text { text: connection; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                    Text { text: driver-text; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    Row {
                        label: I18n.t("Sambungan", "Connection");
                        Seg {
                            width: 170px;
                            options: ["wired", "wireless"];
                            labels: [I18n.t("Kabel (USB)", "Cable (USB)"), "Wi-Fi"];
                            value: root.link;
                            changed(v) => { root.set-link(v); }
                        }
                    }
                    Text {
                        text: root.mode == "usbdirect"
                            ? (root.link == "wireless" ? I18n.t("Wi-Fi: pilih ZenLinkStudio di Pencerminan Layar pada perangkat.", "Wi-Fi: pick ZenLinkStudio in Screen Mirroring on the device.") : I18n.t("Kabel: lewat driver libusb0, bitrate tinggi.", "Cable: through the libusb0 driver, high bitrate."))
                            : (root.link == "wireless" ? I18n.t("Wi-Fi: tekan Atur Wi-Fi sekali dengan kabel tersambung. Perangkat yang dicolok tetap jalan lewat kabel.", "Wi-Fi: press Set up Wi-Fi once with the cable in. A plugged-in device still works over the cable.") : I18n.t("Kabel: lewat driver Apple.", "Cable: through Apple's driver."));
                        font-size: 11px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        GlassButton { label: I18n.t("Ganti mode", "Change mode"); tip: I18n.t("Pilih Apple Driver atau ZenLink Studio", "Choose Apple Driver or ZenLink Studio"); clicked => { root.driver-action("mode"); } }
                        GlassButton { label: I18n.t("Periksa driver", "Check drivers"); clicked => { root.driver-action("refresh"); } }
                        GlassButton { label: I18n.t("Atur Wi-Fi", "Set up Wi-Fi"); clicked => { root.driver-action("wifi"); } }
                    }
                    if root.drv-filter || root.drv-restore || root.drv-bind: HorizontalLayout {
                        spacing: 6px;
                        if root.drv-filter: GlassButton { primary: true; label: I18n.t("Hapus filter libusb0", "Remove libusb0 filter"); clicked => { root.driver-action("removefilter"); } }
                        if root.drv-restore: GlassButton { label: I18n.t("Kembalikan driver Apple", "Restore Apple driver"); clicked => { root.driver-action("restore"); } }
                        if root.drv-bind: GlassButton { label: I18n.t("Pasang driver ZenLink Studio", "Install ZenLink Studio driver"); clicked => { root.driver-action("bind"); } }
                    }
                }

                Card {
                    title: I18n.t("Lanjutan", "Advanced");
                    icon: "\u{E713}";
                    tint-a: #a1a1aa;
                    tint-b: #52525b;
                    Row { label: I18n.t("Mulai otomatis saat dicolok", "Start when plugged in"); Toggle { checked: prefs.auto-start; toggled(v) => { root.prefs.auto-start = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("Tutup ke tray", "Close to the tray"); Toggle { checked: prefs.close-to-tray; toggled(v) => { root.prefs.close-to-tray = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("Selalu di atas", "Always on top"); Toggle { checked: prefs.on-top; toggled(v) => { root.prefs.on-top = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("Statistik di header", "Stats in the header"); Toggle { checked: prefs.stats; toggled(v) => { root.prefs.stats = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: I18n.t("Statistik (terukur)", "Stats (measured)");
                    icon: "\u{E9D9}";
                    tint-a: #facc15;
                    tint-b: #ca8a04;
                    info: I18n.t("Semua angka diukur langsung: fps decode, fps tampil, frame terlewat (diganti frame lebih baru sebelum tampil), waktu decode frame terakhir.",
                        "All numbers are measured: decoded fps, presented fps, skipped frames (replaced by a newer frame before display), last frame decode time.");
                    Text { text: stats-full; font-size: 11.5px; color: Theme.text-2; font-family: "Cascadia Mono"; wrap: word-wrap; }
                }
                Card {
                    title: I18n.t("Potong tepi (halus)", "Edge crop (fine)");
                    icon: "\u{E7A8}";
                    tint-a: #94a3b8;
                    tint-b: #64748b;
                    info: I18n.t("Buang garis hitam atau pinggiran dari gambar, dalam piksel asli perangkat. Sentuhan tetap tepat di posisinya.",
                        "Trim black bars or borders off the picture, in device pixels. Touches still land in the right place.");
                    for side[i] in [
                        { key: "t", id: "Atas", en: "Top" },
                        { key: "b", id: "Bawah", en: "Bottom" },
                        { key: "l", id: "Kiri", en: "Left" },
                        { key: "r", id: "Kanan", en: "Right" },
                    ]: VerticalLayout {
                        spacing: 2px;
                        property <float> v: side.key == "t" ? prefs.crop-t : side.key == "b" ? prefs.crop-b : side.key == "l" ? prefs.crop-l : prefs.crop-r;
                        Row {
                            label: I18n.t(side.id, side.en);
                            Text { text: round(v) + " px"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                        }
                        GlassSlider {
                            maximum: 200;
                            step: 2;
                            value: v;
                            changed(x) => {
                                if side.key == "t" { root.prefs.crop-t = x; }
                                if side.key == "b" { root.prefs.crop-b = x; }
                                if side.key == "l" { root.prefs.crop-l = x; }
                                if side.key == "r" { root.prefs.crop-r = x; }
                                root.changed(root.prefs);
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        GlassButton {
                            label: I18n.t("Reset (0 px)", "Reset (0 px)");
                            clicked => {
                                root.prefs.crop-t = 0; root.prefs.crop-b = 0; root.prefs.crop-l = 0; root.prefs.crop-r = 0;
                                root.changed(root.prefs);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ZenLink";
    icon: @image-url("../../../../ui/logo-256.png");
    background: transparent;
    // Phone-shaped until the first frame tells the real size.
    preferred-width: 480px;
    preferred-height: 820px;
    min-width: 470px; // header fits (logo, name, buttons, window controls)
    min-height: 420px;
    default-font-family: "Segoe UI Variable Text";

    in-out property <Prefs> prefs;
    in-out property <bool> settings-open: true; // Settings start open (docked at the side)
    in property <string> phase: "idle";
    in property <string> device;
    in property <string> link;
    in property <string> message;
    in property <string> stats-line;
    in property <string> stats-full;
    in property <string> driver-text;
    in property <string> connection;
    in property <bool> muted;
    in property <string> toast;
    // v2-style connect card (see Placeholder).
    in property <int> flow-step: -1;
    in property <bool> flow-failed: false;
    in property <string> flow-kind: "apple";
    in property <bool> device-wifi: false;
    in property <string> device-need;
    callback flow-dismiss();
    callback need-fix();
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    // Notice sheet (driver changes).
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-body;
    in property <string> sheet-ok;
    in property <string> sheet-cancel;
    callback sheet-answer(bool);
    // Connection mode chooser (shown until a mode is chosen).
    in-out property <bool> chooser-open: false;
    in property <bool> chooser-cancelable: false;
    in property <string> mode-active;
    in property <string> mode-link: "wired";
    in property <bool> mode-remember: true;
    callback choose-mode(string, string, bool);
    callback set-link(string);
    // Animated dot field (rendered in Rust) and the cursor over the stage.
    in property <image> dots-image;
    out property <bool> stage-hover: stage-ta.has-hover;
    out property <length> stage-mouse-x: stage-ta.mouse-x;
    out property <length> stage-mouse-y: stage-ta.mouse-y;

    // Where the native video view goes (logical px). Read by Rust.
    out property <length> stage-x: stage.absolute-position.x;
    out property <length> stage-y: stage.absolute-position.y;
    out property <length> stage-w: stage.width;
    out property <length> stage-h: stage.height;
    // Everything around the picture: paddings, bars, settings.
    // Settings slide: 0 = closed, 1 = open. Spring-like ease-out (fast start,
    // soft landing), shared by the panel and the window width in Rust.
    property <float> sp: settings-open ? 1 : 0;
    // Materialize curves (shayann07/liquidglass, Apache-2.0): in 320 ms,
    // out 240 ms.
    animate sp { duration: settings-open ? 320ms : 240ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    out property <length> chrome-w: 16px + 368px * sp;
    out property <length> chrome-h: 16px + 46px + 8px + 8px + 46px;

    callback start-cast();
    callback stop-cast();
    callback restart();
    callback prefs-changed(Prefs);
    callback action(string);
    callback driver-action(string);
    callback settings-toggled(bool);
    callback window-action(string);
    no-frame: true;
    forward-focus: keys;

    // Narrow window: icon-only buttons. Set from Rust (window width), not
    // from layout, so the layout cannot feed back into it.
    in property <bool> compact: false;
    in property <bool> maximized: false;
    in property <bool> fullscreen: false;
    // Picture column too narrow for labelled shortcuts.
    in property <bool> compact-bar: false;
    // Full screen / maximised: square edges to the screen border (no
    // rounded corners showing the desktop, no resize strips).
    property <bool> edge: root.fullscreen || root.maximized;
    // F11 toggles full screen, Esc leaves it.
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.F11 { root.window-action("fullscreen"); return accept; }
            if ev.text == Key.Escape && root.fullscreen { root.window-action("fullscreen"); return accept; }
            reject
        }
    }
    Rectangle {
        // Full screen has nothing behind the glass (Windows shows grey or
        // black there): solid theme colour instead, so light stays light.
        background: root.fullscreen ? (Theme.dark ? #121214 : #f2f2f7) : Theme.base;
        border-radius: root.edge ? 0px : 12px;
        clip: true;
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            TopBar {
                compact: root.compact;
                maximized: root.maximized;
                fullscreen: root.fullscreen;
                device: root.device;
                phase: root.phase;
                link: root.link;
                need: root.device-need;
                stats: root.prefs.stats ? root.stats-line : "";
                settings-open: root.settings-open;
                muted: root.muted;
                fit: root.prefs.fit;
                window-action(a) => { root.window-action(a); }
                start => { root.start-cast(); }
                stop => { root.stop-cast(); }
                restart => { root.restart(); }
                settings => {
                    root.settings-open = !root.settings-open;
                    root.settings-toggled(root.settings-open);
                }
                mute => { root.action("mute"); }
                rotate => { root.action("rotate"); }
                fit-next => {
                    root.prefs.fit = root.prefs.fit == "contain" ? "cover" : root.prefs.fit == "cover" ? "fill" : "contain";
                    root.prefs-changed(root.prefs);
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    stage := Rectangle {
                        vertical-stretch: 1;
                        border-radius: 22px;
                        background: root.phase == "streaming" ? Theme.stage : Theme.panel;
                        border-width: 1px;
                        border-color: Theme.edge;
                        clip: true;
                        stage-ta := TouchArea { }
                        if root.phase != "streaming" && root.prefs.dots: Image {
                            source: root.dots-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                        if root.phase != "streaming": Placeholder {
                            phase: root.phase;
                            device: root.device;
                            message: root.message;
                            flow-step: root.flow-step;
                            flow-failed: root.flow-failed;
                            flow-kind: root.flow-kind;
                            wifi: root.device-wifi;
                            need: root.device-need;
                            fix => { root.need-fix(); }
                            start => { root.start-cast(); }
                            dismiss => { root.flow-dismiss(); }
                        }
                    }
                    BottomBar {
                        compact: root.compact-bar;
                        action(a) => { root.action(a); }
                    }
                }
                // Slides in from the right edge while the window grows.
                if root.sp > 0.001: Rectangle {
                    width: 368px * root.sp;
                    clip: true;
                    SettingsPanel {
                    x: 8px + (1 - root.sp) * 28px;
                    width: 360px;
                    height: parent.height;
                    opacity: min(1, root.sp * 1.6);
                    prefs: root.prefs;
                    driver-text: root.driver-text;
                    connection: root.connection;
                    link: root.mode-link;
                    mode: root.mode-active;
                    drv-restore: root.drv-restore;
                    drv-bind: root.drv-bind;
                    drv-filter: root.drv-filter;
                    set-link(l) => { root.set-link(l); }
                    stats-full: root.stats-full;
                    changed(p) => { root.prefs = p; root.prefs-changed(p); }
                    close => { root.settings-open = false; root.settings-toggled(false); }
                    driver-action(a) => { root.driver-action(a); }
                    }
                }
            }
        }
        // Resize from every edge and corner (no system frame).
        for e in [
            { id: "n", x: 10px, y: 0px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "s", x: 10px, y: -5px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "w", x: 0px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "e", x: -5px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "nw", x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "se", x: -10px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "ne", x: -10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
            { id: "sw", x: 0px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        ]: TouchArea {
            enabled: !root.edge;
            x: e.x < 0 ? parent.width + e.x : e.x;
            y: e.y < 0 ? parent.height + e.y : e.y;
            width: e.w < 0 ? parent.width + e.w : e.w;
            height: e.h < 0 ? parent.height + e.h : e.h;
            mouse-cursor: e.c;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.window-action("resize-" + e.id);
                }
            }
        }
        if root.chooser-open: ModeChooser {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            cancelable: root.chooser-cancelable;
            active: root.mode-active;
            link: root.mode-link;
            remember: root.mode-remember;
            prefs: root.prefs;
            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
            choose(m, l, r) => { root.chooser-open = false; root.choose-mode(m, l, r); }
            cancel => { root.chooser-open = false; }
        }
        if root.sheet-open: NoticeSheet {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            title: root.sheet-title;
            body: root.sheet-body;
            ok: root.sheet-ok;
            cancel: root.sheet-cancel;
            answer(yes) => { root.sheet-answer(yes); }
        }
        // Hover tooltip: below the control, or above it near the bottom.
        tip := Rectangle {
            property <bool> above: Tip.bottom + 40px > root.height;
            width: min(tipT.preferred-width + 20px, 280px);
            height: tipT.preferred-height + 12px;
            x: max(8px, min(root.width - self.width - 8px, Tip.x - self.width / 2));
            y: above ? Tip.top - self.height - 6px : Tip.bottom + 6px;
            border-radius: 9px;
            background: Theme.dark ? #26283af2 : #ffffffee;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #0000003a;
            opacity: Tip.shown ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { delay: Tip.shown ? 350ms : 0ms; duration: 120ms; }
            tipT := Text {
                text: Tip.text;
                font-size: 11.5px;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width - 20px;
            }
        }
        if root.toast != "": Glass {
            strong: true;
            x: (parent.width - self.width) / 2;
            property <float> t: 0;
            init => { self.t = 1; }
            animate t { duration: 420ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            opacity: self.t;
            y: parent.height - 104px + 16px * (1 - self.t); // above the dock, rises in
            width: min(parent.width - 40px, toastT.preferred-width + 32px);
            height: 36px;
            border-radius: 12px;
            toastT := Text { text: root.toast; font-size: 12.5px; color: Theme.text; }
        }
    }
}
