// Liquid Glass tokens. Light is the default; Dark is its twin.
// `glass` (0..1) is clarity, set from Rust: 0 = solid (glass off),
// 1 = fully clear (thickness 0%), in between = thicker frosted glass.

export global Theme {
    in-out property <bool> dark: false;
    in-out property <float> glass: 1.0;

    out property <color> text: dark ? #f5f5f7 : #1d1d1f;
    out property <color> text-2: dark ? #ebebf5a6 : #3c3c4399;
    out property <color> text-3: dark ? #ebebf580 : #3c3c4380;
    out property <color> accent: dark ? #ff73bc : #e8509c;
    out property <color> btn: dark ? #ff73bc : #f46bac;
    out property <color> btn-hover: dark ? #ff8fca : #e84f9c;
    out property <color> btn-text: dark ? #2a0618 : #ffffff;
    out property <color> accent-soft: dark ? #ff73bc2e : #f46bac24;
    // Surfaces lerp from solid (glass off) to glass (clarity 1). Dark glass
    // is white light over the dark blurred desktop, like iOS.
    // At full clarity a light dim stays (iOS dark glass dims what is behind).
    out property <color> base: dark ? #121214.mix(#0000002e, 1 - glass) : #f2f2f7.mix(#ffffff24, 1 - glass);
    out property <color> panel: dark ? #1c1c1e.mix(#ffffff0f, 1 - glass) : #ffffff.mix(#ffffff2e, 1 - glass);
    // Mirrored screen while streaming: calm and solid.
    out property <color> stage: dark ? #0a0a0c.mix(#0a0a0ce0, 1 - glass) : #f2f2f7.mix(#f2f2f7e0, 1 - glass);
    out property <color> raise: dark ? #2c2c2e.mix(#ffffff1f, 1 - glass) : #ffffff.mix(#ffffff8c, 1 - glass);
    out property <color> hover: dark ? #ffffff2e : #ffffffd9;
    out property <color> edge: dark ? #ffffff24 : #ffffffcc;
    // Liquid Glass rim: specular edge from the top-left light, catching
    // light again bottom-right where the bezel bends it back.
    out property <brush> rim: glass <= 0.01 ? (dark ? #ffffff1a : #0000001a)
        : dark ? @linear-gradient(135deg, #ffffff73 0%, #ffffff14 38%, #ffffff08 62%, #ffffff40 100%)
        : @linear-gradient(135deg, #ffffffff 0%, #ffffff8c 35%, #ffffff40 62%, #ffffffe6 100%);
    out property <color> line: dark ? #ffffff1a : #0000001a;
    out property <color> shadow: dark ? #00000073 : #0000001f;
    out property <color> ok: #2fc26b;
    out property <color> warn: #f2a53a;
    out property <color> bad: #ef5466;
    out property <length> radius: 14px;
    out property <string> icons: "Segoe Fluent Icons";
}

export global I18n {
    // Indonesian is the default language.
    in-out property <bool> id: true;
    public pure function t(id-text: string, en-text: string) -> string {
        return self.id ? id-text : en-text;
    }
}
