import { Theme, I18n } from "theme.slint";

// A glass surface: translucent fill, bright top edge, soft shadow.
// Hover tooltip, drawn once on top of everything by AppWindow.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;      // centre of the hovered control
    in-out property <length> top;    // its top edge
    in-out property <length> bottom; // its bottom edge
    in-out property <bool> shown;
}

export component Glass inherits Rectangle {
    in property <bool> strong: false;
    // Glass resting on other glass (cards in a sheet): no shadow of its own.
    in property <bool> nested: false;
    background: strong ? Theme.raise : Theme.panel;
    border-radius: 18px;
    border-width: Theme.glass > 0.01 ? 0.75px : 1px;
    border-color: Theme.glass > 0.01 ? Theme.rim : Theme.edge;
    drop-shadow-blur: nested ? 0px : Theme.glass > 0 ? 30px : 10px;
    drop-shadow-offset-y: nested ? 0px : 10px;
    drop-shadow-color: nested ? transparent : Theme.shadow;
    // Specular: light catches the top edge, brightest in the middle.
    Rectangle {
        y: 0.75px;
        x: parent.border-radius * 0.6;
        width: parent.width - parent.border-radius * 1.2;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, Theme.dark ? #ffffff59 : #ffffffff 50%, #ffffff00 100%);
        opacity: Theme.glass;
    }
    // Soft inner sheen under the top edge (very faint).
    Rectangle {
        y: 1px;
        x: 1px;
        width: parent.width - 2px;
        height: min(parent.height * 0.35, 28px);
        border-top-left-radius: max(0px, parent.border-radius - 1px);
        border-top-right-radius: max(0px, parent.border-radius - 1px);
        background: @linear-gradient(180deg, Theme.dark ? #ffffff0d : #ffffff59 0%, #ffffff00 100%);
        opacity: Theme.glass;
    }
    @children
}

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component GlassButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    min-height: 32px;
    // Icon-only: square-ish 34x32.
    min-width: label == "" ? 34px : 0px;
    border-radius: self.height / 2;
    background: primary ? (ta.has-hover ? Theme.btn-hover : Theme.btn)
        : active ? Theme.accent-soft
        : ta.has-hover ? Theme.fill-hover : Theme.fill;
    border-width: 0.75px;
    border-color: primary ? (Theme.glass > 0.01 ? @linear-gradient(135deg, #ffffff99 0%, #ffffff00 50%, #ffffff4d 100%) : transparent)
        : Theme.glass > 0.01 ? Theme.rim : Theme.line;
    drop-shadow-blur: primary ? 12px : 0px;
    drop-shadow-color: primary ? #ec489959 : transparent;
    drop-shadow-offset-y: 3px;
    opacity: enabled ? 1 : 0.45;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    // Liquid Glass press: the lens swells (1.04) and lights up, then
    // settles back with one small bounce.
    transform-scale-x: ta.pressed ? 104% : 100%;
    transform-scale-y: ta.pressed ? 104% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 210ms : 240ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    animate background { duration: 180ms; easing: ease-out; }
    animate opacity { duration: 200ms; }
    // Illumination under the pointer (fades in 90 ms, out 260 ms).
    Rectangle {
        property <length> gx: ta.mouse-x;
        property <length> gy: ta.mouse-y;
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        clip: true;
        opacity: ta.pressed ? 1 : ta.has-hover ? 0.55 : 0;
        animate opacity { duration: ta.pressed || ta.has-hover ? 90ms : 260ms; }
        Rectangle {
            width: max(root.width, root.height) * 1.6;
            height: self.width;
            x: parent.gx - self.width / 2;
            y: parent.gy - self.height / 2;
            background: @radial-gradient(circle, Theme.dark ? #ffffff38 : #ffffffb3 0%, #ffffff00 60%);
        }
    }
    HorizontalLayout {
        padding-left: label == "" ? 8px : 11px;
        padding-right: label == "" ? 8px : 12px;
        spacing: 6px;
        alignment: center;
        if icon != "": Icon {
            text: icon;
            // Sized for the 32px button: icon fills ~half, centred.
            font-size: 15px;
            color: primary ? Theme.btn-text : active ? Theme.accent : Theme.text;
        }
        if label != "": Text {
            text: label;
            font-size: 12.5px;
            font-weight: primary ? 600 : 500;
            color: primary ? Theme.btn-text : active ? Theme.accent : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { Tip.shown = false; root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                Tip.text = root.tip;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
                Tip.shown = true;
            } else if Tip.text == root.tip {
                Tip.shown = false;
            }
        }
    }

}

// Segmented control: one of `options` (values) with `labels`.
export component Seg inherits Rectangle {
    in property <[string]> options;
    in property <[string]> labels;
    in-out property <string> value;
    callback changed(string);
    height: 30px;
    border-radius: self.height / 2;
    background: Theme.dark ? #7676803d : #7676801f;
    property <int> n: max(1, options.length);
    property <int> sel: value == options[0] ? 0 : value == options[1] ? 1 : value == options[2] ? 2 : value == options[3] ? 3 : value == options[4] ? 4 : value == options[5] ? 5 : -1;
    property <length> cell: (self.width - 4px - (n - 1) * 2px) / n;
    // The selected pill glides to the new option.
    Rectangle {
        x: 2px + root.sel * (root.cell + 2px);
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? #ffffff2e : #ffffff;
        border-width: 0.75px;
        border-color: Theme.rim;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.shadow;
        visible: root.sel >= 0;
        animate x { duration: 360ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    for opt[i] in root.options: Rectangle {
        x: 2px + i * (root.cell + 2px);
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        border-radius: self.height / 2;
        background: root.value != opt && ta.has-hover ? (Theme.dark ? #ffffff0a : #ffffff80) : transparent;
        animate background { duration: 150ms; }
        Text {
            text: root.labels[i];
            font-size: 12px;
            font-weight: root.value == opt ? 600 : 400;
            color: root.value == opt ? Theme.text : Theme.text-2;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.value = opt;
                root.changed(opt);
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.btn : (Theme.dark ? #ffffff26 : #20212a26);
    animate background { duration: 220ms; easing: ease-out; }
    Rectangle {
        height: 18px;
        y: 2px;
        width: tt.pressed ? 23px : 18px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 9px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x, width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    tt := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Simple glass slider, 0..max.
export component GlassSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    callback changed(float);
    height: 22px;
    property <float> k: (value - minimum) / max(1, maximum - minimum);
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.dark ? #ffffff26 : #20212a1f;
    }
    Rectangle {
        x: 0;
        width: (root.width - 16px) * k + 8px;
        height: 4px;
        border-radius: 2px;
        background: Theme.btn;
    }
    Rectangle {
        x: (root.width - 16px) * k;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000033;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            let f = max(0, min(1, (x - 8px) / max(1px, root.width - 16px)));
            let v = round((root.minimum + f * (root.maximum - root.minimum)) / root.step) * root.step;
            if v != root.value {
                root.value = v;
                root.changed(v);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.set(self.mouse-x); }
        }
        moved => { if self.pressed { self.set(self.mouse-x); } }
    }
}

// A settings row: label, optional hint, control on the right.
export component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 10px;
    alignment: stretch;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: label; font-size: 12.5px; color: Theme.text; wrap: word-wrap; }
        if hint != "": Text { text: hint; font-size: 11px; color: Theme.text-3; wrap: word-wrap; }
    }
    @children
}

// Settings card: title, an (i) button that expands the explanation, content.
export component Card inherits Glass {
    in property <string> title;
    in property <string> info;
    in property <string> icon;
    // Badge colour pair (ZenLink pink by default).
    in property <color> tint-a: #f472b6;
    in property <color> tint-b: #db2777;
    property <bool> open: false;
    strong: false;
    nested: true;
    background: Theme.card;
    border-radius: 22px;
    VerticalLayout {
        padding: 14px;
        padding-top: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 9px;
            if root.icon != "": Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 8px;
                background: @linear-gradient(145deg, root.tint-a 0%, root.tint-b 100%);
                border-width: 1px;
                border-color: #ffffff59;
                drop-shadow-blur: 6px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: root.tint-b.with-alpha(0.35);
                Icon { text: root.icon; font-size: 13px; color: white; }
            }
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 650;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.info != "": Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: root.open ? Theme.accent-soft : itA.has-hover ? Theme.hover : transparent;
                Icon { text: "\u{E946}"; font-size: 12px; color: root.open ? Theme.accent : Theme.text-3; }
                itA := TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
            }
        }
        if root.open: Rectangle {
            border-radius: 12px;
            background: Theme.accent-soft;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.18);
            VerticalLayout {
                padding: 10px;
                Text { text: root.info; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
            }
        }
        @children
    }
}

export component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: 16px;
    background: ta.pressed ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.raise;
    animate background { duration: 180ms; easing: ease-out; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: ta.pressed ? 104% : 100%;
    transform-scale-y: ta.pressed ? 104% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 210ms : 240ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    border-width: 1px;
    border-color: Theme.line;
    min-width: 36px;
    // Illumination under the pointer (fades in 90 ms, out 260 ms).
    Rectangle {
        property <length> gx: ta.mouse-x;
        property <length> gy: ta.mouse-y;
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        clip: true;
        opacity: ta.pressed ? 1 : ta.has-hover ? 0.55 : 0;
        animate opacity { duration: ta.pressed || ta.has-hover ? 90ms : 260ms; }
        Rectangle {
            width: max(root.width, root.height) * 1.6;
            height: self.width;
            x: parent.gx - self.width / 2;
            y: parent.gy - self.height / 2;
            background: @radial-gradient(circle, Theme.dark ? #ffffff38 : #ffffffb3 0%, #ffffff00 60%);
        }
    }
    HorizontalLayout {
        padding-left: root.label == "" ? 10px : 11px;
        padding-right: root.label == "" ? 10px : 12px;
        spacing: 6px;
        alignment: center;
        Icon { text: root.icon; font-size: 14px; }
        if root.label != "": Text { text: root.label; font-size: 12.5px; color: Theme.text; vertical-alignment: center; }
    }
    in property <string> tip;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tip.shown = false; root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                Tip.text = root.tip;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
                Tip.shown = true;
            } else if Tip.text == root.tip {
                Tip.shown = false;
            }
        }
    }
}
