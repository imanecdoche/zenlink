import { Theme, I18n } from "theme.slint";

// A glass surface: translucent fill, bright top edge, soft shadow.
export component Glass inherits Rectangle {
    in property <bool> strong: false;
    background: strong ? Theme.raise : Theme.panel;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-blur: Theme.glass > 0 ? 24px : 10px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
    // Specular highlight along the top edge.
    Rectangle {
        y: 1px;
        height: min(parent.height * 0.45, 40px);
        x: 1px;
        width: parent.width - 2px;
        border-top-left-radius: parent.border-radius - 1px;
        border-top-right-radius: parent.border-radius - 1px;
        background: @linear-gradient(180deg, Theme.dark ? #ffffff12 : #ffffffa0 0%, #ffffff00 100%);
        opacity: Theme.glass;
    }
    @children
}

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component GlassButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    min-height: 32px;
    min-width: label == "" ? 34px : 0px;
    border-radius: 10px;
    background: primary ? (ta.has-hover ? Theme.btn-hover : Theme.btn)
        : active ? Theme.accent-soft
        : ta.has-hover ? Theme.hover : Theme.raise;
    border-width: 1px;
    border-color: primary ? transparent : Theme.line;
    opacity: enabled ? 1 : 0.45;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: label == "" ? 8px : 11px;
        padding-right: label == "" ? 8px : 12px;
        spacing: 6px;
        alignment: center;
        if icon != "": Icon {
            text: icon;
            font-size: 13px;
            color: primary ? Theme.btn-text : active ? Theme.accent : Theme.text;
        }
        if label != "": Text {
            text: label;
            font-size: 12.5px;
            font-weight: primary ? 600 : 500;
            color: primary ? Theme.btn-text : active ? Theme.accent : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    states [
        pressed when ta.pressed: { opacity: 0.8; }
    ]
}

// Segmented control: one of `options` (values) with `labels`.
export component Seg inherits Rectangle {
    in property <[string]> options;
    in property <[string]> labels;
    in-out property <string> value;
    callback changed(string);
    height: 30px;
    border-radius: 10px;
    background: Theme.dark ? #ffffff0d : #20212a0d;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            border-radius: 8px;
            background: root.value == opt ? Theme.raise : ta.has-hover ? (Theme.dark ? #ffffff0a : #ffffff80) : transparent;
            border-width: root.value == opt ? 1px : 0px;
            border-color: Theme.edge;
            drop-shadow-blur: root.value == opt ? 4px : 0px;
            drop-shadow-color: Theme.shadow;
            Text {
                text: root.labels[i];
                font-size: 12px;
                font-weight: root.value == opt ? 600 : 400;
                color: root.value == opt ? Theme.text : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.value = opt;
                    root.changed(opt);
                }
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.btn : (Theme.dark ? #ffffff26 : #20212a26);
    animate background { duration: 140ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 2px;
        x: root.checked ? root.width - 20px : 2px;
        border-radius: 9px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Simple glass slider, 0..max.
export component GlassSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    callback changed(float);
    height: 22px;
    property <float> k: (value - minimum) / max(1, maximum - minimum);
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.dark ? #ffffff26 : #20212a1f;
    }
    Rectangle {
        x: 0;
        width: (root.width - 16px) * k + 8px;
        height: 4px;
        border-radius: 2px;
        background: Theme.btn;
    }
    Rectangle {
        x: (root.width - 16px) * k;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000033;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            let f = max(0, min(1, (x - 8px) / max(1px, root.width - 16px)));
            let v = round((root.minimum + f * (root.maximum - root.minimum)) / root.step) * root.step;
            if v != root.value {
                root.value = v;
                root.changed(v);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.set(self.mouse-x); }
        }
        moved => { if self.pressed { self.set(self.mouse-x); } }
    }
}

// A settings row: label, optional hint, control on the right.
export component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 10px;
    alignment: stretch;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: label; font-size: 12.5px; color: Theme.text; wrap: word-wrap; }
        if hint != "": Text { text: hint; font-size: 11px; color: Theme.text-3; wrap: word-wrap; }
    }
    @children
}

// Settings card: title, an (i) button that expands the explanation, content.
export component Card inherits Glass {
    in property <string> title;
    in property <string> info;
    property <bool> open: false;
    strong: false;
    border-radius: 16px;
    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        spacing: 9px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                color: Theme.text-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.info != "": Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.open ? Theme.accent-soft : itA.has-hover ? Theme.hover : transparent;
                Icon { text: "\u{E946}"; font-size: 12px; color: root.open ? Theme.accent : Theme.text-3; }
                itA := TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
            }
        }
        if root.open: Rectangle {
            border-radius: 10px;
            background: Theme.accent-soft;
            VerticalLayout {
                padding: 9px;
                Text { text: root.info; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
            }
        }
        @children
    }
}

export component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: 16px;
    background: ta.pressed ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.raise;
    border-width: 1px;
    border-color: Theme.line;
    min-width: 34px;
    HorizontalLayout {
        padding-left: root.label == "" ? 10px : 11px;
        padding-right: root.label == "" ? 10px : 12px;
        spacing: 6px;
        alignment: center;
        Icon { text: root.icon; font-size: 12px; }
        if root.label != "": Text { text: root.label; font-size: 12px; color: Theme.text; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
