#include <winver.h>
#include "zlaac_ver.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ZL_VER_NUM
PRODUCTVERSION ZL_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Zenvy Zenshiro"
            VALUE "FileDescription", "ZenLink AAC decoder (FFmpeg, LGPL-2.1+)"
            VALUE "FileVersion", ZL_VER_STR
            VALUE "InternalName", "zlaac"
            VALUE "LegalCopyright", "Copyright (C) 2026 Zenvy Zenshiro. GPL-3.0-or-later. Uses FFmpeg (LGPL-2.1-or-later)."
            VALUE "OriginalFilename", "zlaac.dll"
            VALUE "ProductName", "ZenLink Next"
            VALUE "ProductVersion", ZL_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
